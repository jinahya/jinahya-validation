<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>jinahya-validation-10</artifactId>
    <version>0.0.3</version>
  </parent>

  <artifactId>jinahya-validation-test-utils-10</artifactId>

  <name>${project.artifactId}</name>
  <description>Test utilities for Jakarta Validation, for Jakarta EE 10 (Jakarta Validation 3.0)</description>

  <properties>
    <shared.module>jinahya-validation-test-utils</shared.module>
    <!-- AssertJ is a compile dependency of this module, so it must run on Java SE 11, which 4.x does not; 3.27 is the
         latest series which does -->
    <!-- https://central.sonatype.com/artifact/org.assertj/assertj-bom/versions -->
    <version.org.assertj>3.27.7</version.org.assertj>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-validation-utils-10</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
