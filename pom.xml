<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>jinahya-parent</artifactId>
    <version>1.1.4</version>
  </parent>

  <groupId>io.github.jinahya</groupId>
  <artifactId>jinahya-validation</artifactId>
  <version>0.0.5-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>${project.artifactId}</name>
  <description>Jakarta Validation extensions</description>
  <!-- url, scm, and issueManagement name this repository literally, never ${project.artifactId}, and are inherited
       unchanged (the inherit.append.path attributes): every module is in this one repository -->
  <url>https://github.com/jinahya/jinahya-validation</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Jinahya, Inc.</name>
    <url>https://jinahya.com</url>
  </organization>

  <developers>
    <developer>
      <id>onacit</id>
      <name>Kwon, Jin</name>
      <email>onacit@gmail.com</email>
      <url>https://github.com/onacit</url>
      <roles>
        <role>developer</role>
      </roles>
      <timezone>Asia/Seoul</timezone>
    </developer>
  </developers>

  <!-- One module per Jakarta EE generation, each the parent of that generation's artifacts, which carry the
       generation in their artifactIds (jinahya-validation-utils-11, ...); see jinahyaee-bom. -->
  <modules>
    <module>jinahya-validation-10</module>
    <module>jinahya-validation-11</module>
  </modules>

  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:git@github.com:jinahya/jinahya-validation.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/jinahya-validation.git</developerConnection>
    <url>https://github.com/jinahya/jinahya-validation</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jinahya/jinahya-validation/issues</url>
  </issueManagement>

  <properties>
    <!-- maven.compiler.source, the release of the main classes, is each jinahya-validation-NN parent's: the minimum
         Java SE of its Jakarta EE generation, enforced there by the enforce-require-jakartaee-java-version execution -->
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <!-- https://endoflife.date/eclipse-temurin -->
    <!-- the release of the test classes, for every generation; the build JDK must be at least this -->
    <maven.compiler.testSource>25</maven.compiler.testSource>
    <maven.compiler.testTarget>${maven.compiler.testSource}</maven.compiler.testTarget>
    <maven.compiler.testRelease>${maven.compiler.testSource}</maven.compiler.testRelease>
    <doclint>all</doclint>
    <version.maven-failsafe>${version.maven-surefire}</version.maven-failsafe>
    <version.maven-surefire>3.6.1</version.maven-surefire>
    <!-- each jinahya-validation-NN/* module, two levels down, sets shared.module to its directory under shared/ -->
    <shared.directory>${project.basedir}/../../shared/${shared.module}</shared.directory>
    <!-- Java versions: each jinahya-validation-NN compiles its main classes for its Jakarta EE generation's minimum
         Java SE, and everything those classes need at runtime (every dependency outside the test scope) must run
         there too, which each generation enforces. The build itself, the test classes, and the test dependencies
         are on the latest JDK that can still compile for every generation's minimum, at their latest releases
         that support it. -->
    <!-- The platform (the Jakarta EE BOM) and every implementation of a Jakarta specification (the validation
         providers, Expressly) are versioned by each jinahya-validation-NN parent, never here. -->
    <!-- https://central.sonatype.com/artifact/org.assertj/assertj-bom/versions -->
    <version.org.assertj>4.0.0-M1</version.org.assertj>
    <!-- https://central.sonatype.com/artifact/org.junit/junit-bom/versions -->
    <version.org.junit>6.1.3</version.org.junit>
    <!-- https://central.sonatype.com/artifact/org.mockito/mockito-junit-jupiter/versions -->
    <version.org.mockito>5.24.0</version.org.mockito>
    <!-- https://central.sonatype.com/artifact/org.projectlombok/lombok/versions -->
    <version.org.projectlombok>1.18.48</version.org.projectlombok>
    <!-- https://central.sonatype.com/artifact/org.slf4j/slf4j-bom/versions -->
    <version.org.slf4j>2.0.20</version.org.slf4j>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <!-- https://central.sonatype.com/artifact/org.assertj/assertj-bom/versions -->
        <groupId>org.assertj</groupId>
        <artifactId>assertj-bom</artifactId>
        <version>${version.org.assertj}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <!-- https://search.maven.org/artifact/org.junit/junit-bom -->
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.org.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-junit-jupiter</artifactId>
        <version>${version.org.mockito}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-bom</artifactId>
        <version>${version.org.slf4j}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <!-- the Jakarta Validation API, Expressly, and the validation provider come from each jinahya-validation-NN parent -->
  <dependencies>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${version.org.projectlombok}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-javadoc-plugin/versions -->
          <version>3.12.0</version>
          <configuration>
            <additionalOptions>
              <additionalOption>-Xdoclint:${doclint},-missing</additionalOption>
            </additionalOptions>
            <failOnError>true</failOnError>
            <failOnWarnings>true</failOnWarnings>
            <links>
              <!-- jakartaee is set by each jinahya-validation-NN parent -->
              <link>https://jakarta.ee/specifications/platform/${jakartaee}/apidocs/</link>
            </links>
            <release>${maven.compiler.testRelease}</release>
            <tags>
              <tag>
                <name>apiNote</name>
                <placement>a</placement>
                <head>API Note:</head>
              </tag>
              <tag>
                <name>implSpec</name>
                <placement>a</placement>
                <head>Implementation Requirements:</head>
              </tag>
              <tag>
                <name>implNote</name>
                <placement>a</placement>
                <head>Implementation Note:</head>
              </tag>
            </tags>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-jar-plugin/versions -->
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-project-info-reports-plugin/versions -->
          <version>3.9.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-site-plugin/versions -->
          <version>3.22.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>2.25.1</version>
          <configuration>
            <processDependencyManagementTransitive>false</processDependencyManagementTransitive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.16</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${version.org.projectlombok}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Xlint</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.7.0</version>
        <dependencies>
          <dependency>
            <!-- enforceBytecodeVersion, which each jinahya-validation-NN parent uses -->
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>extra-enforcer-rules</artifactId>
            <!-- https://central.sonatype.com/artifact/org.codehaus.mojo/extra-enforcer-rules/versions -->
            <version>1.12.1</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>enforce-dependency-convergence</id>
            <configuration>
              <rules>
                <dependencyConvergence />
              </rules>
            </configuration>
            <goals>
              <goal>enforce</goal>
            </goals>
          </execution>
          <execution>
            <!-- The test classes are compiled for maven.compiler.testRelease, whatever the generation; a JDK older
                 than that would fail much later, in testCompile, far from the cause. -->
            <id>enforce-require-test-java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[${maven.compiler.testRelease},)</version>
                  <message>The test classes are compiled for Java ${maven.compiler.testRelease}; build with a JDK
                    ${maven.compiler.testRelease} or newer.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-require-maven-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-require-profile-ids-exist</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProfileIdsExist />
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${version.maven-surefire}</version>
        <configuration>
          <skipAfterFailureCount>1</skipAfterFailureCount>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <!-- A jinahya-validation-NN module holds only what is specific to its generation; everything common to
               every generation lives once, under shared/<shared.module>/, and is compiled by each module against
               its own generation's API. A module names its shared directory with the shared.module property. A
               directory which does not exist is skipped, so create one only when there is a source which needs it.
               In either place, src/test/java-<validation-provider> holds the tests of the active provider. -->
          <execution>
            <id>add-shared-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${shared.directory}/src/main/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-shared-and-provider-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${shared.directory}/src/test/java</source>
                <source>${shared.directory}/src/test/java-${validation-provider}</source>
                <source>src/test/java-${validation-provider}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.9.0</version>
        <configuration>
          <licenseName>apache_v2</licenseName>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>default-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>default-report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The validation provider profiles, hibernate-validator (active by default) and apache-bval, are each
         jinahya-validation-NN parent's, since only a generation knows the providers' versions. -->
    <profile>
      <id>failsafe</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>${version.maven-failsafe}</version>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <skipAfterFailureCount>1</skipAfterFailureCount>
              <trimStackTrace>false</trimStackTrace>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
